rules_version = '2';

// Scale Architect: who may read and write what in Firestore.
// Deploy: Firebase console → Firestore → Rules (paste this), or
//   npx firebase-tools deploy --only firestore:rules --project <project-id>
//
// Each player has two documents that only they can read or write:
//   users/{uid}     their saved game and progress
//   profiles/{uid}  their profile: name, picture, title, bio, UPI ID
// You (the owner) still see everything in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validUser(request.resource.data);
    }

    match /profiles/{uid} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validProfile(request.resource.data);
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validUser(d) {
      return d.keys().hasOnly(['save', 'savedAt', 'productId', 'level', 'levelCompleted', 'progress',
                               'name', 'email', 'photoURL', 'createdAt', 'lastSeen'])
        && (!('save' in d) || (d.save is string && d.save.size() < 900000))
        && (!('savedAt' in d) || d.savedAt is number)
        && (!('progress' in d) || d.progress is map)
        && (!('name' in d) || (d.name is string && d.name.size() <= 200))
        && (!('email' in d) || (d.email is string && d.email.size() <= 320));
    }

    // Same limits as js/firebase/profile.js (cleanProfile). An uploaded picture is a
    // small JPEG/PNG/WebP kept inline as a data: URL (no Firebase Storage needed).
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'title', 'bio', 'upi', 'avatar', 'photo', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && (!('title' in d) || (d.title is string && d.title.size() <= 60))
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 280))
        && (!('upi' in d) || (d.upi is string && d.upi.size() <= 100
            && (d.upi == '' || d.upi.matches('[a-z0-9][a-z0-9._-]{1,63}@[a-z][a-z0-9]{1,31}'))))
        && d.avatar is string
        && (d.avatar == 'google' || d.avatar == 'upload' || (d.avatar.matches('emoji:.+') && d.avatar.size() <= 24))
        && (!('photo' in d) || (d.photo is string && d.photo.size() <= 100000
            && (d.photo == '' || d.photo.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'))))
        && (d.avatar != 'upload' || ('photo' in d && d.photo != ''))
        && (!('updatedAt' in d) || d.updatedAt == request.time);
    }
  }
}
