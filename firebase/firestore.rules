rules_version = '2';

// Scale Architect: who may read and write what in Firestore.
// Deploy: Firebase console → Firestore → Rules (paste this), or
//   npx firebase-tools deploy --only firestore:rules --project <project-id>
//
// Each player has one document, users/{uid}, that only they can read or write.
// You (the owner) still see everything in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validUser(request.resource.data);
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validUser(d) {
      return d.keys().hasOnly(['save', 'savedAt', 'productId', 'level', 'levelCompleted', 'progress',
                               'name', 'email', 'photoURL', 'createdAt', 'lastSeen'])
        && (!('save' in d) || (d.save is string && d.save.size() < 900000))
        && (!('savedAt' in d) || d.savedAt is number)
        && (!('progress' in d) || d.progress is map)
        && (!('name' in d) || (d.name is string && d.name.size() <= 200))
        && (!('email' in d) || (d.email is string && d.email.size() <= 320));
    }
  }
}
